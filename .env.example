# 复制本文件为 .env 并填入真实密钥
# .env 已被 .gitignore 忽略，不会提交到仓库

# 必填：默认模型（config.yaml → llm.providers.deepseek）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 按需：领域知识库嵌入（config.yaml → domain_kb.embedding，硅基流动 Qwen3-Embedding-8B）
# SILICONFLOW_API_KEY=

# 按需：其他 provider 模板（config.yaml → llm.providers 注释段，取消对应行注释后使用）
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# HUNYUAN_API_KEY=
# ZHIPU_API_KEY=
# DASHSCOPE_API_KEY=
# MOONSHOT_API_KEY=
